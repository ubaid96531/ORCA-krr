# Optional GraphDB connection (leave unset for offline RDFLibStore mode)
# ORCA_GRAPHDB_URL=http://localhost:7200
# ORCA_GRAPHDB_REPO=orca

# LLM Configuration for KG-Grounded Assistant & Evaluation
# Choose "local" (default, uses HuggingFace Transformers on CPU), "api", or "auto"
ORCA_LLM_BACKEND=local
ORCA_LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional OpenAI-compatible API settings (only used if ORCA_LLM_BACKEND=api or auto with key)
# ORCA_LLM_BASE_URL=https://api.openai.com/v1
# ORCA_LLM_API_KEY=your-api-key-here
# ORCA_LLM_MODEL=gpt-4o-mini

# Optional Vite override for separate dev server
# VITE_API_URL=http://127.0.0.1:8000
