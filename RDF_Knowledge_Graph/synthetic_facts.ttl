database:AccountDirectory a orca:Database ;
    rdfs:label "Account directory" ;
    rdfs:comment "Directory of user accounts and their sign-in logs." ;
    orca:provenanceLabel "Synthetic_Fact" .

user:LeilaHartmann a orca:HumanUser ;
